{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "PeakDatabase": ""
  },
  "IngestionWorker": {
    "Mode": "Automatic"
  },
  "Ingestion": {
    "Endpoint": "https://query.wikidata.org/sparql",
    "UserAgent": "PeakerIngestion/1.0 (https://github.com/peaker-app)",
    "DelayBetweenRequests": "00:00:02",
    "DeferredRetryDelay": "00:01:00",
    "RequestTimeout": "00:02:00",
    "NameBatchSize": 500,
    "ElevationBandMeters": 250,
    "MinElevationBandMeters": 15,
    "MinElevationMeters": 0,
    "MaxElevationMeters": 9000,
    "Language": "en",
    "AlternativeNameLanguages": [ "es", "en", "fr", "zh", "ar", "it", "de", "ca", "eu", "gl", "pt" ],
    "DuplicateRadiusMeters": 250,
    "DuplicateNameSimilarity": 0.6
  },
  "Outbox": {
    "PollingInterval": "00:00:10",
    "BatchSize": 20
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
